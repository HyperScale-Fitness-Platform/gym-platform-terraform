pipeline {
    agent any

    tools {
        terraform 'Terraform'
    }

    options {
        disableConcurrentBuilds()
    }

    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_DEFAULT_REGION    = 'us-east-1'
        
        INFRA_DIR             = './infrastructure'
        SERVICES_DIR          = './services'
        CLUSTER_NAME          = 'gym-cluster'

        PATH                  = "${WORKSPACE}/.tools/bin:${env.PATH}"
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Bootstrap CLI Tools') {
            steps {
                sh '''
                    set -e
                    TOOL_BIN="${WORKSPACE}/.tools/bin"
                    mkdir -p "${TOOL_BIN}"

                    # 1. Install AWS CLI v2 if missing
                    if ! command -v aws >/dev/null 2>&1; then
                        echo "Installing AWS CLI v2..."
                        curl -s "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "/tmp/awscliv2.zip"
                        unzip -q -o /tmp/awscliv2.zip -d /tmp/
                        /tmp/aws/install --install-dir "${WORKSPACE}/.tools/aws-cli" --bin-dir "${TOOL_BIN}" --update
                        rm -rf /tmp/aws /tmp/awscliv2.zip
                    fi

                    # 2. Install kubectl if missing
                    if ! command -v kubectl >/dev/null 2>&1; then
                        echo "Installing kubectl..."
                        curl -sLO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
                        chmod +x kubectl
                        mv kubectl "${TOOL_BIN}/"
                    fi

                    # 3. Install envsubst if missing
                    if ! command -v envsubst >/dev/null 2>&1; then
                        echo "Installing envsubst..."
                        curl -sL https://github.com/a8m/envsubst/releases/download/v1.2.0/envsubst-`uname -s`-`uname -m` -o "${TOOL_BIN}/envsubst"
                        chmod +x "${TOOL_BIN}/envsubst"
                    fi

                    # Verification (avoid -v on Go binary)
                    echo "--- Tool Versions & Checks ---"
                    aws --version
                    kubectl version --client
                    echo "envsubst available at: $(which envsubst)"
                '''
            }
        }

        stage('Clean Kubernetes Resources & Delete Ingress') {
            steps {
                sh '''
                    if aws eks update-kubeconfig --region ${AWS_DEFAULT_REGION} --name ${CLUSTER_NAME} > /dev/null 2>&1; then
                        echo "Deleting Kubernetes Ingress objects to trigger ALB cleanup..."
                        kubectl delete ingress --all --all-namespaces --timeout=60s || true

                        echo "Stripping finalizers from Argo CD applications to prevent deletion blocks..."
                        kubectl get applications -n argocd -o name 2>/dev/null | xargs -I {} kubectl patch {} -n argocd -p '{"metadata":{"finalizers":null}}' --type=merge || true
                        kubectl delete applications --all -n argocd --timeout=30s || true
                        
                        # Delete target namespaces
                        kubectl delete namespace gym-dev --ignore-not-found=true --timeout=30s || true
                        kubectl delete namespace gym-prod --ignore-not-found=true --timeout=30s || true
                        kubectl delete namespace argocd --ignore-not-found=true --timeout=30s || true
                        kubectl delete namespace external-secrets --ignore-not-found=true --timeout=30s || true
                    else
                        echo "Cluster not reachable. Skipping K8s namespace cleanup."
                    fi
                '''
            }
        }

        stage('Run Pre-Destroy Cleanup (ALB, ENIs, ECR)') {
            steps {
                sh '''
                    chmod +x ./scripts/pre-destroy.sh
                    ./scripts/pre-destroy.sh
                '''
            }
        }

        stage('Destroy Layer 2: Helm Services') {
            steps {
                dir("${env.SERVICES_DIR}") {
                    sh '''
                        AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query "Account" --output text)
                        BUCKET_NAME="gym-platform-tfstate-${AWS_ACCOUNT_ID}"
                        
                        terraform init -reconfigure -backend-config="bucket=${BUCKET_NAME}" -input=false
                        terraform destroy -auto-approve -var="state_bucket_name=${BUCKET_NAME}" -input=false || echo "Helm destroy skipped/completed."
                    '''
                }
            }
        }

        stage('Destroy Layer 1: EKS & Infrastructure') {
            steps {
                dir("${env.INFRA_DIR}") {
                    sh '''
                        AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query "Account" --output text)
                        BUCKET_NAME="gym-platform-tfstate-${AWS_ACCOUNT_ID}"

                        terraform init -reconfigure -backend-config="bucket=${BUCKET_NAME}" -input=false
                        terraform destroy -auto-approve -input=false
                    '''
                }
            }
        }

        stage('Delete S3 Backend & DynamoDB Table') {
            steps {
                sh '''
                    chmod +x ./scripts/delete-s3.sh
                    ./scripts/delete-s3.sh
                '''
            }
        }
    }

    post {
        always {
            dir("${env.SERVICES_DIR}") {
                sh 'rm -f tfplan'
            }
            dir("${env.INFRA_DIR}") {
                sh 'rm -f tfplan'
            }
        }
        success {
            echo '=========================================================='
            echo '  ALL INFRASTRUCTURE AND SERVICES SUCCESSFULLY DESTROYED  '
            echo '=========================================================='
        }
        failure {
            echo 'Terraform Destroy Pipeline Failed! Check console output for orphaned resources.'
        }
    }
}
pipeline {
    agent any

    tools {
        terraform 'Terraform'
    }

    options {
        disableConcurrentBuilds()
    }

    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_DEFAULT_REGION    = 'us-east-1'
        
        INFRA_DIR             = './infrastructure'
        SERVICES_DIR          = './services'
        CLUSTER_NAME          = 'gym-cluster'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Delete ECR Images') {
            steps {
                sh '''
                    chmod +x ./scripts/delete-ecr-images.sh
                    ./scripts/delete-ecr-images.sh
                '''
            }
        }

        stage('Destroy Layer 2: Helm Services') {
            steps {
                dir("${env.SERVICES_DIR}") {
                    sh 'rm -f terraform.tfstate terraform.tfstate.backup'
                    sh 'terraform init -reconfigure -input=false'
                    sh 'terraform destroy -auto-approve -input=false'
                }
            }
        }

        stage('Clean Kubernetes Namespaces & Finalizers') {
            steps {
                sh '''
                    # Connect to EKS cluster if still accessible
                    if aws eks update-kubeconfig --region ${AWS_DEFAULT_REGION} --name ${CLUSTER_NAME} > /dev/null 2>&1; then
                        echo "Cleaning up lingering K8s namespaces and resources..."
                        
                        # Delete Argo CD applications to trigger graceful resource deletion
                        kubectl delete applications --all -n argocd --timeout=60s || true
                        
                        # Delete target namespaces
                        kubectl delete namespace argocd --ignore-not-found=true --timeout=60s || true
                        kubectl delete namespace jenkins --ignore-not-found=true --timeout=60s || true
                        kubectl delete namespace external-secrets --ignore-not-found=true --timeout=60s || true
                    else
                        echo "Cluster not reachable or already partially destroyed. Skipping K8s cleanup."
                    fi
                '''
            }
        }

        stage('Destroy Layer 1: EKS & Infrastructure') {
            steps {
                dir("${env.INFRA_DIR}") {
                    sh 'rm -f terraform.tfstate terraform.tfstate.backup'
                    sh 'terraform init -reconfigure -input=false'
                    sh 'terraform destroy -auto-approve -input=false'
                }
            }
        }

        stage('Delete S3 Backend & DynamoDB Table') {
            steps {
                sh '''
                    chmod +x ./scripts/delete-s3.sh
                    ./scripts/delete-s3.sh
                '''
            }
        }
    }

    post {
        always {
            dir("${env.SERVICES_DIR}") {
                sh 'rm -f tfplan'
            }
            dir("${env.INFRA_DIR}") {
                sh 'rm -f tfplan'
            }
        }
        success {
            echo '=========================================================='
            echo '  ALL INFRASTRUCTURE AND SERVICES SUCCESSFULLY DESTROYED  '
            echo '=========================================================='
        }
        failure {
            echo 'Terraform Destroy Pipeline Failed! Check console output for orphaned resources.'
        }
    }
}
pipeline {
    agent any

    tools {
        terraform 'Terraform'
    }

    // Prevent concurrent runs from conflicting on Terraform state
    options {
        disableConcurrentBuilds()
    }

    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_DEFAULT_REGION    = 'us-east-1'
        
        SECRET_NAME           = 'eks/jenkins/admin-password'
        INFRA_DIR             = './infrastructure'
        SERVICES_DIR          = './services'
        MANIFESTS_DIR         = './k8s'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Destroy Helm Services (Layer 2)') {
            steps {
                dir("${env.SERVICES_DIR}") {
                    sh 'terraform init -reconfigure'
                    sh 'terraform destroy -auto-approve'
                }
            }
        }

        stage('Delete K8s Manifests & Namespaces') {
            steps {
                sh '''
                    # Update kubeconfig in case cluster is still accessible
                    if aws eks describe-cluster --name gym-cluster --region us-east-1 > /dev/null 2>&1; then
                        aws eks update-kubeconfig --region us-east-1 --name gym-cluster

                        # Delete custom manifests prior to cluster teardown
                        kubectl delete -f ${MANIFESTS_DIR}/ --ignore-not-found=true
                        kubectl delete namespace jenkins --ignore-not-found=true
                    else
                        echo "Cluster 'gym-cluster' not found or already destroyed. Skipping K8s cleanup."
                    fi
                '''
            }
        }

        stage('Destroy EKS & Infrastructure (Layer 1)') {
            steps {
                dir("${env.INFRA_DIR}") {
                    sh 'terraform init -reconfigure'
                    sh 'terraform destroy -auto-approve'
                }
            }
        }

        stage('Delete Secrets from AWS Secrets Manager') {
            steps {
                sh '''
                    # Force delete secret without recovery window if present
                    if aws secretsmanager describe-secret --secret-id "${SECRET_NAME}" > /dev/null 2>&1; then
                        echo "Deleting secret '${SECRET_NAME}'..."
                        aws secretsmanager delete-secret \
                            --secret-id "${SECRET_NAME}" \
                            --force-delete-without-recovery
                    else
                        echo "Secret '${SECRET_NAME}' does not exist. Skipping."
                    fi
                '''
            }
        }
    }

    post {
        always {
            dir("${env.INFRA_DIR}") {
                sh 'rm -f tfplan'
            }
            dir("${env.SERVICES_DIR}") {
                sh 'rm -f tfplan'
            }
        }
        success {
            echo 'Infrastructure and services destroyed successfully!'
        }
        failure {
            echo 'Infrastructure Destroy Pipeline failed!'
        }
    }
}
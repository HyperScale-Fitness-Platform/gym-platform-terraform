pipeline {
    agent any

    tools {
        terraform 'Terraform'
    }

    // Prevent concurrent runs from conflicting on Terraform state
    options {
        disableConcurrentBuilds()
    }

    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_DEFAULT_REGION    = 'us-east-1'
        
        SECRET_NAME           = 'eks/jenkins/admin-password'
        INFRA_DIR             = './infrastructure'
        SERVICES_DIR          = './services'
        MANIFESTS_DIR         = './k8s'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Ensure Remote State Backend Exists') {
            steps {
                sh '''
                    chmod +x ./scripts/create-s3-for-statefile.sh
                    ./scripts/create-s3-for-statefile.sh
                '''
            }
        }

        stage('Sync Secrets to AWS Secrets Manager') {
            steps {
                withCredentials([string(credentialsId: 'jenkins-admin-pass', variable: 'JENKINS_ADMIN_PASS')]) {
                    sh '''
                        # Check if secret already exists in AWS Secrets Manager
                        if aws secretsmanager describe-secret --secret-id "${SECRET_NAME}" > /dev/null 2>&1; then
                            echo "Secret '${SECRET_NAME}' exists. Updating value..."
                            aws secretsmanager put-secret-value \
                                --secret-id "${SECRET_NAME}" \
                                --secret-string "${JENKINS_ADMIN_PASS}"
                        else
                            echo "Secret '${SECRET_NAME}' does not exist. Creating..."
                            aws secretsmanager create-secret \
                                --name "${SECRET_NAME}" \
                                --secret-string "${JENKINS_ADMIN_PASS}"
                        fi
                    '''
                }
            }
        }

        stage('Deploy EKS & Infrastructure (Layer 1)') {
            steps {
                dir("${env.INFRA_DIR}") {
                    sh 'terraform init'
                    sh 'terraform apply -auto-approve'
                }
            }
        }

        stage('Pre-Create K8s Namespaces & External Secrets') {
            steps {
                sh '''
                    # Update kubeconfig for cluster access
                    aws eks update-kubeconfig --region ${AWS_DEFAULT_REGION} --name gym-cluster

                    # Create namespaces if they do not exist
                    kubectl create namespace jenkins --dry-run=client -o yaml | kubectl apply -f -
                    kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply -f -

                    # Apply ClusterSecretStore and ExternalSecret to sync secret BEFORE Helm installs
                    kubectl apply -f ${MANIFESTS_DIR}/
                '''
            }
        }

        stage('Deploy Helm Services (Layer 2)') {
            steps {
                dir("${env.SERVICES_DIR}") {
                    sh 'terraform init'
                    sh 'terraform apply -auto-approve'
                }
            }
        }

        stage('Fetch Argo CD Admin Password') {
            steps {
                sh '''
                    echo "=========================================================="
                    echo "  WAITING FOR ARGO CD INITIAL ADMIN SECRET TO GENERATE... "
                    echo "=========================================================="
                    
                    # Ensure cluster context is active
                    aws eks update-kubeconfig --region ${AWS_DEFAULT_REGION} --name gym-cluster

                    # Wait for secret to exist (up to 2 minutes)
                    until kubectl get secret argocd-initial-admin-secret -n argocd > /dev/null 2>&1; do
                        echo "Waiting for argocd-initial-admin-secret to be created..."
                        sleep 5
                    done

                    # Retrieve and print decoded password
                    ARGOCD_PASS=$(kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath="{.data.password}" | base64 -d)
                    
                    echo "=========================================================="
                    echo "  ARGO CD ACCESS CREDENTIALS"
                    echo "=========================================================="
                    echo "  URL:      https://localhost:8081 (via kubectl port-forward)"
                    echo "  Username: admin"
                    echo "  Password: ${ARGOCD_PASS}"
                    echo "=========================================================="
                '''
            }
        }
    }

    post {
        always {
            // Clean up temporary files or plans across directories
            dir("${env.INFRA_DIR}") {
                sh 'rm -f tfplan'
            }
            dir("${env.SERVICES_DIR}") {
                sh 'rm -f tfplan'
            }
        }
        failure {
            echo 'Terraform Pipeline failed!'
        }
    }
}
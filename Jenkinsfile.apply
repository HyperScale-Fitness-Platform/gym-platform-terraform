pipeline {
    agent any

    tools {
        terraform 'Terraform'
    }

    // Prevent concurrent runs from conflicting on Terraform state
    options {
        disableConcurrentBuilds()
    }

    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_DEFAULT_REGION    = 'us-east-1'
        
        SECRET_NAME           = 'eks/jenkins/admin-password'
        TF_DIR                = './env' 
        MANIFESTS_DIR         = './k8s'
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Sync Secrets to AWS Secrets Manager') {
            steps {
                withCredentials([string(credentialsId: 'jenkins-admin-pass', variable: 'JENKINS_ADMIN_PASS')]) {
                    sh '''
                        # Check if secret already exists in AWS Secrets Manager
                        if aws secretsmanager describe-secret --secret-id "${SECRET_NAME}" > /dev/null 2>&1; then
                            echo "Secret '${SECRET_NAME}' exists. Updating value..."
                            aws secretsmanager put-secret-value \
                                --secret-id "${SECRET_NAME}" \
                                --secret-string "${JENKINS_ADMIN_PASS}"
                        else
                            echo "Secret '${SECRET_NAME}' does not exist. Creating..."
                            aws secretsmanager create-secret \
                                --name "${SECRET_NAME}" \
                                --secret-string "${JENKINS_ADMIN_PASS}"
                        fi
                    '''
                }
            }
        }

        stage('Terraform Init') {
            steps {
                dir("${env.TF_DIR}") {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Validate & Format') {
            steps {
                dir("${env.TF_DIR}") {
                    sh 'terraform fmt -check'
                    sh 'terraform validate'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir("${env.TF_DIR}") {
                    // Save plan output to a file
                    sh 'terraform plan -out=tfplan'
                }
            }
        }

        stage('Approval') {
            steps {
                script {
                    // Pause execution for manual confirmation before applying changes
                    input message: 'Do you want to apply this Terraform plan?', 
                          ok: 'Apply'
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir("${env.TF_DIR}") {
                    // Apply saved plan file directly
                    sh 'terraform apply -input=false tfplan'
                }
            }
        }

        stage('Apply Kubernetes Manifests') {
            steps {
                sh '''
                    # Update local kubeconfig to connect kubectl to the newly provisioned EKS cluster
                    aws eks update-kubeconfig --region us-east-1 --name gym-cluster

                    # Apply ClusterSecretStore and ExternalSecret YAML files
                    kubectl apply -f ${MANIFESTS_DIR}/
                '''
            }
        }
    }

    post {
        always {
            // Clean up saved plan file to protect sensitive data
            dir("${env.TF_DIR}") {
                sh 'rm -f tfplan'
            }
        }
        failure {
            echo 'Terraform Pipeline failed!'
        }
    }
}
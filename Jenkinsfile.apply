pipeline {
    agent any

    tools {
        terraform 'Terraform'
    }

    options {
        disableConcurrentBuilds()
    }

    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        AWS_DEFAULT_REGION    = 'us-east-1'

        LETSENCRYPT_EMAIL     = 'mustafatarek104@gmail.com'

        SECRET_NAME           = 'eks/jenkins/admin-password'
        SECRET_NAME_DUCKDNS   = 'eks/cert-manager/duckdns-token'
        INFRA_DIR             = './infrastructure'
        SERVICES_DIR          = './services'
        MANIFESTS_DIR         = './k8s'

        // Prepend local tool folder to PATH for all stages
        PATH                  = "${WORKSPACE}/.tools/bin:${env.PATH}"
    }

    stages {
        stage('Checkout Code') {
            steps {
                checkout scm
            }
        }

        stage('Bootstrap CLI Tools') {
            steps {
                sh '''
                    set -e
                    TOOL_BIN="${WORKSPACE}/.tools/bin"
                    mkdir -p "${TOOL_BIN}"

                    # 1. Install AWS CLI v2 if missing
                    if ! command -v aws >/dev/null 2>&1; then
                        echo "Installing AWS CLI v2..."
                        curl -s "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "/tmp/awscliv2.zip"
                        unzip -q -o /tmp/awscliv2.zip -d /tmp/
                        /tmp/aws/install --install-dir "${WORKSPACE}/.tools/aws-cli" --bin-dir "${TOOL_BIN}" --update
                        rm -rf /tmp/aws /tmp/awscliv2.zip
                    fi

                    # 2. Install kubectl if missing
                    if ! command -v kubectl >/dev/null 2>&1; then
                        echo "Installing kubectl..."
                        curl -sLO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
                        chmod +x kubectl
                        mv kubectl "${TOOL_BIN}/"
                    fi

                    # 3. Install envsubst if missing
                    if ! command -v envsubst >/dev/null 2>&1; then
                        echo "Installing envsubst..."
                        curl -sL https://github.com/a8m/envsubst/releases/download/v1.2.0/envsubst-`uname -s`-`uname -m` -o "${TOOL_BIN}/envsubst"
                        chmod +x "${TOOL_BIN}/envsubst"
                    fi

                    echo "--- Tool Versions & Checks ---"
                    aws --version
                    kubectl version --client
                    echo "envsubst available at: $(which envsubst)"
                '''
            }
        }

        stage('Ensure Remote State Backend Exists') {
            steps {
                sh '''
                    chmod +x ./scripts/create-s3-for-statefile.sh
                    ./scripts/create-s3-for-statefile.sh
                '''
            }
        }

        stage('Sync Secrets to AWS Secrets Manager') {
            steps {
                withCredentials([string(credentialsId: 'jenkins-admin-pass', variable: 'JENKINS_ADMIN_PASS')]) {
                    sh '''
                        if aws secretsmanager describe-secret --secret-id "${SECRET_NAME}" > /dev/null 2>&1; then
                            echo "Secret '${SECRET_NAME}' exists. Updating value..."
                            aws secretsmanager put-secret-value \
                                --secret-id "${SECRET_NAME}" \
                                --secret-string "${JENKINS_ADMIN_PASS}"
                        else
                            echo "Secret '${SECRET_NAME}' does not exist. Creating..."
                            aws secretsmanager create-secret \
                                --name "${SECRET_NAME}" \
                                --secret-string "${JENKINS_ADMIN_PASS}"
                        fi
                    '''
                }
                withCredentials([usernamePassword(credentialsId: 'github-creds', usernameVariable: 'GH_USER', passwordVariable: 'GH_PAT')]) {
                    sh '''
                        SECRET_NAME_GITHUB="gitops/image-updater/github-creds"

                        if aws secretsmanager describe-secret --secret-id "${SECRET_NAME_GITHUB}" > /dev/null 2>&1; then
                            echo "Secret '${SECRET_NAME_GITHUB}' exists. Updating value..."
                            aws secretsmanager put-secret-value \
                                --secret-id "${SECRET_NAME_GITHUB}" \
                                --secret-string "{\\"username\\":\\"${GH_USER}\\",\\"password\\":\\"${GH_PAT}\\"}"
                        else
                            echo "Secret '${SECRET_NAME_GITHUB}' does not exist. Creating..."
                            aws secretsmanager create-secret \
                                --name "${SECRET_NAME_GITHUB}" \
                                --secret-string "{\\"username\\":\\"${GH_USER}\\",\\"password\\":\\"${GH_PAT}\\"}"
                        fi
                    '''
                }
                withCredentials([string(credentialsId: 'duckdns-token', variable: 'DUCKDNS_TOKEN')]) {
                    sh '''
                        if aws secretsmanager describe-secret --secret-id "${SECRET_NAME_DUCKDNS}" > /dev/null 2>&1; then
                            echo "Secret '${SECRET_NAME_DUCKDNS}' exists. Updating value..."
                            aws secretsmanager put-secret-value \
                                --secret-id "${SECRET_NAME_DUCKDNS}" \
                                --secret-string "${DUCKDNS_TOKEN}"
                        else
                            echo "Secret '${SECRET_NAME_DUCKDNS}' does not exist. Creating..."
                            aws secretsmanager create-secret \
                                --name "${SECRET_NAME_DUCKDNS}" \
                                --secret-string "${DUCKDNS_TOKEN}"
                        fi
                    '''
                }
            }
        }

        stage('Deploy EKS & Infrastructure (Layer 1)') {
            steps {
                dir("${env.INFRA_DIR}") {
                    sh '''
                        AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query "Account" --output text)
                        BUCKET_NAME="gym-platform-tfstate-${AWS_ACCOUNT_ID}"
                        
                        rm -f terraform.tfstate terraform.tfstate.backup
                        terraform init -reconfigure -backend-config="bucket=${BUCKET_NAME}" -input=false
                        terraform apply -auto-approve -input=false
                    '''
                }
            }
        }

        stage('Pre-Create K8s Namespaces & Secrets') {
            steps {
                sh '''
                    aws eks update-kubeconfig --region ${AWS_DEFAULT_REGION} --name gym-cluster

                    kubectl create namespace jenkins --dry-run=client -o yaml | kubectl apply -f -
                    kubectl create namespace argocd --dry-run=client -o yaml | kubectl apply -f -
                    kubectl create namespace external-secrets --dry-run=client -o yaml | kubectl apply -f -
                    kubectl create namespace cert-manager --dry-run=client -o yaml | kubectl apply -f -

                    # Export variables for envsubst
                    export SECRET_NAME="${SECRET_NAME}"
                    export SECRET_NAME_DUCKDNS="${SECRET_NAME_DUCKDNS}"

                    # Apply Secrets & SecretStores needed by Helm charts
                    [ -f "${MANIFESTS_DIR}/cluster-secret-store.yaml" ] && envsubst < "${MANIFESTS_DIR}/cluster-secret-store.yaml" | kubectl apply -f -
                    [ -f "${MANIFESTS_DIR}/jenkins-secret.yaml" ] && envsubst < "${MANIFESTS_DIR}/jenkins-secret.yaml" | kubectl apply -f -
                    [ -f "${MANIFESTS_DIR}/github-secret.yaml" ] && envsubst < "${MANIFESTS_DIR}/github-secret.yaml" | kubectl apply -f -
                    [ -f "${MANIFESTS_DIR}/duckdns-secret.yaml" ] && envsubst < "${MANIFESTS_DIR}/duckdns-secret.yaml" | kubectl apply -f -
                '''
            }
        }

        stage('Deploy Helm Services (Layer 2)') {
            steps {
                dir("${env.SERVICES_DIR}") {
                    withCredentials([string(credentialsId: 'duckdns-token', variable: 'DUCKDNS_TOKEN')]) {
                        sh '''
                            AWS_ACCOUNT_ID=$(aws sts get-caller-identity --query "Account" --output text)
                            BUCKET_NAME="gym-platform-tfstate-${AWS_ACCOUNT_ID}"
                            
                            rm -f terraform.tfstate terraform.tfstate.backup
                            terraform init -reconfigure -backend-config="bucket=${BUCKET_NAME}" -input=false
                            terraform apply -auto-approve \
                                -var="state_bucket_name=${BUCKET_NAME}" \
                                -var="duckdns_token=${DUCKDNS_TOKEN}" \
                                -var="acme_email=${LETSENCRYPT_EMAIL}" \
                                -input=false
                        '''
                    }
                }
            }
        }
        
        stage('Configure Post-Helm Resources (ClusterIssuer)') {
            steps {
                sh '''
                    aws eks update-kubeconfig --region ${AWS_DEFAULT_REGION} --name gym-cluster

                    echo "Waiting for cert-manager deployments..."
                    kubectl wait --for=condition=Available deployment/cert-manager -n cert-manager --timeout=120s
                    kubectl wait --for=condition=Available deployment/cert-manager-webhook -n cert-manager --timeout=120s

                    echo "Waiting for duckdns-token secret to be synced by External Secrets..."
                    until kubectl get secret duckdns-token -n cert-manager > /dev/null 2>&1; do
                        echo "Waiting for secret/duckdns-token in cert-manager..."
                        sleep 5
                    done

                    # Apply Let's Encrypt ClusterIssuer with email substitution
                    export email="${LETSENCRYPT_EMAIL}"
                    if [ -f "${MANIFESTS_DIR}/letsencrypt-issuer.yaml" ]; then
                        echo "Applying ClusterIssuer for Let's Encrypt (${email})..."
                        envsubst < "${MANIFESTS_DIR}/letsencrypt-issuer.yaml" | kubectl apply -f -
                    fi
                '''
            }
        }

        stage('Fetch & Display Access Credentials') {
            steps {
                sh '''
                    echo "=========================================================="
                    echo "  CONFIGURING KUBECONFIG & WAITING FOR SERVICES...        "
                    echo "=========================================================="
                    
                    aws eks update-kubeconfig --region ${AWS_DEFAULT_REGION} --name gym-cluster

                    # 1. Fetch Argo CD Credentials
                    echo "Fetching Argo CD initial admin secret..."
                    until kubectl get secret argocd-initial-admin-secret -n argocd > /dev/null 2>&1; do
                        echo "Waiting for argocd-initial-admin-secret..."
                        sleep 5
                    done
                    ARGOCD_PASS=$(kubectl -n argocd get secret argocd-initial-admin-secret -o jsonpath="{.data.password}" | base64 -d)

                    # 2. Fetch Jenkins Credentials
                    echo "Fetching Jenkins admin secret..."
                    until kubectl get secret jenkins-admin-credentials -n jenkins > /dev/null 2>&1; do
                        echo "Waiting for jenkins-admin-credentials..."
                        sleep 5
                    done
                    JENKINS_PASS=$(kubectl -n jenkins get secret jenkins-admin-credentials -o jsonpath="{.data.jenkins-admin-password}" | base64 -d)

                    echo ""
                    echo "=========================================================="
                    echo "                  ACCESS CREDENTIALS                      "
                    echo "=========================================================="
                    echo "  [1] ARGO CD"
                    echo "      Port-Forward:  kubectl port-forward svc/argocd-server -n argocd 8081:443"
                    echo "      URL:           https://localhost:8081"
                    echo "      Username:      admin"
                    echo "      Password:      ${ARGOCD_PASS}"
                    echo "----------------------------------------------------------"
                    echo "  [2] JENKINS"
                    echo "      Port-Forward:  kubectl port-forward svc/jenkins -n jenkins 8080:8080"
                    echo "      URL:           http://localhost:8080"
                    echo "      Username:      admin"
                    echo "      Password:      ${JENKINS_PASS}"
                    echo "=========================================================="
                '''
            }
        }
    }

    post {
        always {
            node('') {
                dir("${env.INFRA_DIR}") {
                    sh 'rm -f tfplan'
                }
                dir("${env.SERVICES_DIR}") {
                    sh 'rm -f tfplan'
                }
            }
        }
        failure {
            echo 'Terraform Pipeline failed!'
        }
    }
}